universe = vanilla
initialdir = /nethome/akolchina/gfp_project
executable = /nethome/akolchina/gfp_project/condor/run_pool_mixing_acquisition.sh
arguments = $(target) $(plate) $(round) $(seed) $(model) cpu $(reference_raw) $(raw)
should_transfer_files = NO
request_cpus = 1
request_memory = 8GB
request_disk = 4GB
requirements = (TARGET.UidDomain == "lsv.uni-saarland.de")
