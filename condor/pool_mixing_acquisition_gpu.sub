universe = vanilla
initialdir = /nethome/akolchina/gfp_project
executable = /nethome/akolchina/gfp_project/condor/run_pool_mixing_acquisition.sh
arguments = $(target) $(plate) $(round) $(seed) $(model) cuda $(reference_raw) $(raw)
should_transfer_files = NO
request_cpus = 2
request_memory = 10GB
request_disk = 4GB
request_gpus = 1
requirements = (TARGET.UidDomain == "lsv.uni-saarland.de") && (TARGET.GPUs_GlobalMemoryMb >= 10000)
output = $(raw)/condor/gpu_$(target)_p$(plate)_r$(round)_s$(seed).$(ClusterId).out
error = $(raw)/condor/gpu_$(target)_p$(plate)_r$(round)_s$(seed).$(ClusterId).err
log = $(raw)/condor/gpu.$(ClusterId).log
queue
