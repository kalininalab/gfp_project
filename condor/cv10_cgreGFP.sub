universe = vanilla
initialdir = /nethome/akolchina/gfp_project
executable = /nethome/akolchina/gfp_project/condor/run_cv_fold.sh
arguments = $(fold)
should_transfer_files = NO
request_cpus = 1
request_memory = 4GB
request_disk = 2GB
request_gpus = 0
requirements = (TARGET.UidDomain == "lsv.uni-saarland.de")
output = /nethome/akolchina/gfp_project/results/cv10_cgreGFP_seed42/condor/fold_$(fold).$(ClusterId).$(ProcId).out
error = /nethome/akolchina/gfp_project/results/cv10_cgreGFP_seed42/condor/fold_$(fold).$(ClusterId).$(ProcId).err
log = /nethome/akolchina/gfp_project/results/cv10_cgreGFP_seed42/condor/events.$(ClusterId).log
queue fold in 4,5,6,7,8,9
