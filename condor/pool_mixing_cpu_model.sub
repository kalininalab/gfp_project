universe = vanilla
initialdir = /nethome/akolchina/gfp_project
executable = /nethome/akolchina/gfp_project/condor/run_pool_mixing.sh
arguments = $(target) $(n_target) $(seed) $(model) cpu $(raw)
should_transfer_files = NO
request_cpus = 1
request_memory = 4GB
request_disk = 2GB
requirements = (TARGET.UidDomain == "lsv.uni-saarland.de")
output = $(raw)/condor/$(model)_$(target)_n$(n_target)_s$(seed).$(ClusterId).out
error = $(raw)/condor/$(model)_$(target)_n$(n_target)_s$(seed).$(ClusterId).err
log = $(raw)/condor/cpu.$(ClusterId).log
queue
