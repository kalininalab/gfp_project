universe = vanilla
initialdir = /nethome/akolchina/gfp_project
executable = /nethome/akolchina/gfp_project/condor/run_ortholog_target_included.sh
arguments = $(directory) $(target) $(condition) $(seed) $(model) cuda
should_transfer_files = NO
request_cpus = 1
request_memory = 8GB
request_disk = 2GB
request_gpus = 1
requirements = (TARGET.UidDomain == "lsv.uni-saarland.de") && (TARGET.GPUs_GlobalMemoryMb >= 10000)
output = $(directory)/condor/gpu_$(target)_$(condition)_$(seed)_$(model).$(ClusterId).out
error = $(directory)/condor/gpu_$(target)_$(condition)_$(seed)_$(model).$(ClusterId).err
log = $(directory)/condor/gpu.$(ClusterId).log
queue
