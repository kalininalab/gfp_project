universe = vanilla
initialdir = /nethome/akolchina/gfp_project
executable = /nethome/akolchina/gfp_project/condor/run_pool_mixing.sh
arguments = $(target) $(n_target) $(seed) CNN_Jannis_OHE cuda $(raw)
should_transfer_files = NO
request_cpus = 1
request_memory = 6GB
request_disk = 2GB
request_gpus = 1
requirements = (TARGET.UidDomain == "lsv.uni-saarland.de") && (TARGET.GPUs_GlobalMemoryMb >= 10000)
output = $(raw)/condor/cnn_$(target)_n$(n_target)_s$(seed).$(ClusterId).out
error = $(raw)/condor/cnn_$(target)_n$(n_target)_s$(seed).$(ClusterId).err
log = $(raw)/condor/gpu.$(ClusterId).log
queue
