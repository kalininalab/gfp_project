universe = vanilla
initialdir = /nethome/akolchina/gfp_project
executable = /nethome/akolchina/gfp_project/condor/run_ortholog_target_included.sh
arguments = $(directory) $(target) $(condition) $(seed) $(model) cpu
should_transfer_files = NO
request_cpus = 1
request_memory = 5GB
request_disk = 2GB
request_gpus = 0
requirements = (TARGET.UidDomain == "lsv.uni-saarland.de")
output = $(directory)/condor/cpu_$(target)_$(condition)_$(seed)_$(model).$(ClusterId).out
error = $(directory)/condor/cpu_$(target)_$(condition)_$(seed)_$(model).$(ClusterId).err
log = $(directory)/condor/cpu.$(ClusterId).log
queue
